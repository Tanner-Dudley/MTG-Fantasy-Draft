# Copy this file to .env and fill in your values.
# .env is in .gitignore and will NOT be committed to git.
# Generate random values with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Secret key used to sign session tokens (JWTs).
JWT_SECRET=change-me

# Password for the Postgres container. docker-compose.yml uses it both to
# create the database user and to build the app's DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Only used when running the app WITHOUT Docker (uvicorn on your PC).
# Under docker compose, DATABASE_URL is set in docker-compose.yml instead.
DATABASE_URL=sqlite:///./dev.db